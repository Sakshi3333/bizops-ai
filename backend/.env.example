DATABASE_URL=postgresql://user:password@localhost:5432/bizops_ai
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY is unused - the AI assistant runs on Gemini now. Leave it blank.
GEMINI_API_KEY=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Set to "production" on the host; the API then refuses to start without a real JWT_SECRET_KEY
ENVIRONMENT=development
# "true" loads the demo company on startup (safe to leave on - it skips if already seeded)
SEED_DEMO_DATA=false
